generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  therapist
  coordinator
}

enum SessionStatus {
  active
  in_progress
  completed
  revoked
}

enum FormStatus {
  not_started
  in_progress
  submitted
}

enum FormCategory {
  intake
  questionnaire
}

enum SessionKind {
  intake
  questionnaire
}

enum AttendanceStatus {
  present_unpaid
  present_paid
  receipt_issued
  absent
}

enum DocumentUploader {
  patient
  therapist
}

enum PiccaEditedBy {
  patient
  therapist
}

enum PiccaSessionStatus {
  active
  in_progress
  completed
  revoked
}

enum CalendarInviteStatus {
  not_sent
  pending
  sent
  failed
  cancelled
}

enum AssessmentPipelineStage {
  intake
  avaliacao
  picca
  relatorio
  concluido
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  name         String
  phone        String?
  role         UserRole
  passwordHash String    @map("password_hash")
  active       Boolean   @default(true)
  financialOverviewEnabled Boolean @default(false) @map("financial_overview_enabled")
  piccaEnabled             Boolean @default(false) @map("picca_enabled")
  appointmentInvitesAllowed Boolean @default(false) @map("appointment_invites_allowed")
  appointmentInvitesEnabled Boolean @default(false) @map("appointment_invites_enabled")
  appointmentInviteRecipients String @default("email") @map("appointment_invite_recipients")
  appointmentInviteCopyToTherapist Boolean @default(true) @map("appointment_invite_copy_to_therapist")
  notepad                  String? @db.Text
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  patients       Patient[]
  intakeSessions IntakeSession[]
  piccaSessions  PiccaSession[]
  piccaInteractiveSessions PiccaInteractiveSession[]
  attendanceRecords AttendanceRecord[]
  appointments   Appointment[]
  workshops      Workshop[]
  patientDocuments PatientDocument[]
  financialSettings TherapistFinancialSettings?
  therapistLocations TherapistLocation[]
  coordinatorTherapists CoordinatorTherapist[] @relation("CoordinatorTherapistAssignments")
  therapistCoordinators CoordinatorTherapist[] @relation("TherapistCoordinatorAssignments")

  @@map("users")
}

model Patient {
  id            String    @id @default(uuid())
  therapistId   String    @map("therapist_id")
  locationId    String    @map("location_id")
  fullName      String    @map("full_name")
  email         String?
  email2        String?   @map("email_2")
  phone         String?
  phone2        String?   @map("phone_2")
  birthDate     DateTime? @map("birth_date") @db.Date
  sessionFee    Decimal?  @map("session_fee") @db.Decimal(10, 2)
  internalNotes String?   @map("internal_notes") @db.Text
  appointmentNotes String? @map("appointment_notes") @db.Text
  wiscSelections Json     @default("[]") @map("wisc_selections")
  bancSelections Json     @default("[]") @map("banc_selections")
  additionalMethodSelections Json @default("[]") @map("additional_method_selections")
  questionnaireSelections Json @default("[]") @map("questionnaire_selections")
  assessmentPipelineStage AssessmentPipelineStage @default(intake) @map("assessment_pipeline_stage")
  assessmentPipelineNotes String? @map("assessment_pipeline_notes") @db.Text
  assessmentReportDeliveredAt DateTime? @map("assessment_report_delivered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  therapist         User              @relation(fields: [therapistId], references: [id])
  location          Location          @relation(fields: [locationId], references: [id])
  intakeSessions    IntakeSession[]
  piccaSessions     PiccaSession[]
  piccaInteractiveSessions PiccaInteractiveSession[]
  attendanceRecords AttendanceRecord[]
  appointments      Appointment[]
  documents         PatientDocument[]

  @@index([therapistId])
  @@index([locationId])
  @@map("patients")
}

model Location {
  id        String   @id @default(uuid())
  name      String
  address   String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  patients Patient[]
  appointments Appointment[]
  gabinetes Gabinete[]
  therapistLocations TherapistLocation[]

  @@map("locations")
}

model TherapistLocation {
  id          String   @id @default(uuid())
  therapistId String   @map("therapist_id")
  locationId  String   @map("location_id")
  createdAt   DateTime @default(now()) @map("created_at")

  therapist User     @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([therapistId])
  @@index([locationId])
  @@map("therapist_locations")
}

model CoordinatorTherapist {
  id            String   @id @default(uuid())
  coordinatorId String   @map("coordinator_id")
  therapistId   String   @map("therapist_id")
  createdAt     DateTime @default(now()) @map("created_at")

  coordinator User @relation("CoordinatorTherapistAssignments", fields: [coordinatorId], references: [id], onDelete: Cascade)
  therapist   User @relation("TherapistCoordinatorAssignments", fields: [therapistId], references: [id], onDelete: Cascade)

  @@index([coordinatorId])
  @@index([therapistId])
  @@map("coordinator_therapists")
}

model Gabinete {
  id         String   @id @default(uuid())
  locationId String   @map("location_id")
  name       String
  active     Boolean  @default(true)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  location     Location      @relation(fields: [locationId], references: [id])
  appointments Appointment[]

  @@index([locationId])
  @@map("gabinetes")
}

model AttendanceRecord {
  id          String           @id @default(uuid())
  patientId   String           @map("patient_id")
  therapistId String           @map("therapist_id")
  sessionDate DateTime         @map("session_date") @db.Date
  status      AttendanceStatus
  notes       String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist User    @relation(fields: [therapistId], references: [id])

  @@unique([patientId, sessionDate])
  @@index([therapistId, sessionDate])
  @@map("attendance_records")
}

model IntakeSession {
  id           String        @id @default(uuid())
  patientId    String        @map("patient_id")
  therapistId  String        @map("therapist_id")
  sessionKind  SessionKind   @default(intake) @map("session_kind")
  tokenHash    String        @unique @map("token_hash")
  patientToken String?       @map("patient_token")
  status       SessionStatus @default(active)
  expiresAt   DateTime?     @map("expires_at")
  completedAt DateTime?     @map("completed_at")
  consentAt   DateTime?     @map("consent_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  patient  Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist User         @relation(fields: [therapistId], references: [id])
  forms    SessionForm[]
  documents PatientDocument[]

  @@index([therapistId])
  @@index([patientId])
  @@map("intake_sessions")
}

model PatientDocument {
  id              String           @id @default(uuid())
  patientId       String           @map("patient_id")
  therapistId     String           @map("therapist_id")
  intakeSessionId String?          @map("intake_session_id")
  originalName    String           @map("original_name")
  mimeType        String           @map("mime_type")
  sizeBytes       Int              @map("size_bytes")
  storagePath     String           @map("storage_path")
  uploadedBy      DocumentUploader @map("uploaded_by")
  createdAt       DateTime         @default(now()) @map("created_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist     User           @relation(fields: [therapistId], references: [id])
  intakeSession IntakeSession? @relation(fields: [intakeSessionId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([therapistId])
  @@map("patient_documents")
}

model FormDefinition {
  id          String       @id
  title       String
  version     Int          @default(1)
  category    FormCategory @default(intake)
  schemaJson  Json?        @map("schema_json")
  active      Boolean      @default(true)
  description String?      @db.Text

  sessionForms SessionForm[]

  @@map("form_definitions")
}

model SessionForm {
  id        String     @id @default(uuid())
  sessionId String     @map("session_id")
  formId    String     @map("form_id")
  status    FormStatus @default(not_started)
  sortOrder Int        @map("sort_order")

  session    IntakeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  definition FormDefinition  @relation(fields: [formId], references: [id])
  draft      FormDraft?
  submission FormSubmission?

  @@unique([sessionId, formId])
  @@index([sessionId])
  @@map("session_forms")
}

model FormDraft {
  sessionFormId String   @id @map("session_form_id")
  answersJson   Json     @map("answers_json")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessionForm SessionForm @relation(fields: [sessionFormId], references: [id], onDelete: Cascade)

  @@map("form_drafts")
}

model FormSubmission {
  sessionFormId String   @id @map("session_form_id")
  answersJson   Json     @map("answers_json")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  ip            String?

  sessionForm SessionForm @relation(fields: [sessionFormId], references: [id], onDelete: Cascade)

  @@map("form_submissions")
}

model Appointment {
  id              String          @id @default(uuid())
  therapistId     String          @map("therapist_id")
  patientId       String          @map("patient_id")
  locationId      String          @map("location_id")
  gabineteId      String          @map("gabinete_id")
  scheduledAt     DateTime        @map("scheduled_at")
  durationMinutes Int             @default(60) @map("duration_minutes")
  sessionFee      Decimal         @default(50) @map("session_fee") @db.Decimal(10, 2)
  notes           String?         @db.Text
  recurrenceGroupId String?       @map("recurrence_group_id")
  recurrenceCadence String?       @map("recurrence_cadence")
  recurrenceUntil   String?       @map("recurrence_until")
  calendarUid       String?       @unique @map("calendar_uid")
  calendarSequence  Int           @default(0) @map("calendar_sequence")
  calendarInviteStatus CalendarInviteStatus @default(not_sent) @map("calendar_invite_status")
  calendarInvitedAt DateTime?     @map("calendar_invited_at")
  calendarInviteError String?     @map("calendar_invite_error") @db.Text
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  therapist User     @relation(fields: [therapistId], references: [id])
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  location  Location @relation(fields: [locationId], references: [id])
  gabinete  Gabinete @relation(fields: [gabineteId], references: [id])

  @@index([therapistId, scheduledAt])
  @@index([patientId])
  @@index([locationId, scheduledAt])
  @@index([gabineteId, scheduledAt])
  @@index([recurrenceGroupId])
  @@index([calendarInviteStatus])
  @@map("appointments")
}

model TherapistFinancialSettings {
  id                  String   @id @default(uuid())
  therapistId         String   @unique @map("therapist_id")
  socialSecurityRate  Decimal  @default(0.15) @map("social_security_rate") @db.Decimal(6, 4)
  irsRate             Decimal  @default(0.20) @map("irs_rate") @db.Decimal(6, 4)
  savingsRate         Decimal  @default(0.10) @map("savings_rate") @db.Decimal(6, 4)
  defaultSessionFee   Decimal  @default(50) @map("default_session_fee") @db.Decimal(10, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  therapist User @relation(fields: [therapistId], references: [id], onDelete: Cascade)

  @@map("therapist_financial_settings")
}

model PiccaModule {
  id            String  @id
  volume        Int
  moduleNumber  Int     @map("module_number")
  sortOrder     Int     @map("sort_order")
  title         String
  description   String? @db.Text
  therapistOnly Boolean @default(false) @map("therapist_only")
  active        Boolean @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sessionModules PiccaSessionModule[]

  @@map("picca_modules")
}

model PiccaSession {
  id           String             @id @default(uuid())
  patientId    String             @map("patient_id")
  therapistId  String             @map("therapist_id")
  tokenHash    String             @unique @map("token_hash")
  patientToken String?            @map("patient_token")
  status       PiccaSessionStatus @default(active)
  consentAt    DateTime?          @map("consent_at")
  revokedAt    DateTime?          @map("revoked_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  patient   Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist User                 @relation(fields: [therapistId], references: [id])
  modules   PiccaSessionModule[]

  @@index([therapistId])
  @@index([patientId])
  @@map("picca_sessions")
}

model PiccaSessionModule {
  id        String     @id @default(uuid())
  sessionId String     @map("session_id")
  moduleId  String     @map("module_id")
  status    FormStatus @default(not_started)
  sortOrder Int        @map("sort_order")

  session    PiccaSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  module     PiccaModule            @relation(fields: [moduleId], references: [id])
  draft      PiccaModuleDraft?
  submission PiccaModuleSubmission?

  @@unique([sessionId, moduleId])
  @@index([sessionId])
  @@map("picca_session_modules")
}

model PiccaModuleDraft {
  sessionModuleId String        @id @map("session_module_id")
  answersJson     Json          @map("answers_json")
  lastEditedBy    PiccaEditedBy @default(patient) @map("last_edited_by")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  sessionModule PiccaSessionModule @relation(fields: [sessionModuleId], references: [id], onDelete: Cascade)

  @@map("picca_module_drafts")
}

model PiccaModuleSubmission {
  sessionModuleId String        @id @map("session_module_id")
  answersJson     Json          @map("answers_json")
  submittedAt     DateTime      @default(now()) @map("submitted_at")
  submittedBy     PiccaEditedBy @default(patient) @map("submitted_by")
  lastEditedAt    DateTime?     @map("last_edited_at")
  lastEditedBy    PiccaEditedBy? @map("last_edited_by")

  sessionModule PiccaSessionModule @relation(fields: [sessionModuleId], references: [id], onDelete: Cascade)

  @@map("picca_module_submissions")
}

enum PiccaInteractiveFormKind {
  daily_sono
  weekly_estrategias
  weekly_kit
  portage_assessment
}

model PiccaInteractiveForm {
  id          String                   @id @db.VarChar(64)
  kind        PiccaInteractiveFormKind
  sortOrder   Int                      @map("sort_order")
  title       String
  description String?                  @db.Text
  active      Boolean                  @default(true)
  createdAt   DateTime                 @default(now()) @map("created_at")
  updatedAt   DateTime                 @updatedAt @map("updated_at")

  sessionForms PiccaInteractiveSessionForm[]
  entries      PiccaInteractiveEntry[]

  @@map("picca_interactive_forms")
}

model PiccaInteractiveSession {
  id           String             @id @default(uuid()) @db.Char(36)
  patientId    String             @map("patient_id")
  therapistId  String             @map("therapist_id")
  tokenHash    String             @unique @map("token_hash") @db.VarChar(64)
  patientToken String?            @map("patient_token") @db.VarChar(64)
  status       PiccaSessionStatus @default(active)
  consentAt    DateTime?          @map("consent_at")
  revokedAt    DateTime?          @map("revoked_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  patient   Patient                       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  therapist User                          @relation(fields: [therapistId], references: [id])
  forms     PiccaInteractiveSessionForm[]
  entries   PiccaInteractiveEntry[]

  @@index([therapistId])
  @@index([patientId])
  @@map("picca_interactive_sessions")
}

model PiccaInteractiveSessionForm {
  id        String @id @default(uuid()) @db.Char(36)
  sessionId String @map("session_id") @db.Char(36)
  formId    String @map("form_id") @db.VarChar(64)
  sortOrder Int    @map("sort_order")

  session PiccaInteractiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  form    PiccaInteractiveForm    @relation(fields: [formId], references: [id])

  @@unique([sessionId, formId])
  @@index([sessionId])
  @@map("picca_interactive_session_forms")
}

model PiccaInteractiveEntry {
  id          String   @id @default(uuid()) @db.Char(36)
  sessionId   String   @map("session_id") @db.Char(36)
  formId      String   @map("form_id") @db.VarChar(64)
  periodKey   String   @map("period_key") @db.VarChar(10)
  answersJson Json     @map("answers_json")
  submittedAt DateTime @default(now()) @map("submitted_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  session PiccaInteractiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  form    PiccaInteractiveForm    @relation(fields: [formId], references: [id])

  @@unique([sessionId, formId, periodKey])
  @@index([sessionId, formId])
  @@map("picca_interactive_entries")
}

model Workshop {
  id          String   @id @default(uuid())
  title       String
  description String   @db.Text
  location    String
  eventDate   DateTime @map("event_date") @db.Date
  imagePath   String   @map("image_path")
  createdById String?  @map("created_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([eventDate])
  @@map("workshops")
}
